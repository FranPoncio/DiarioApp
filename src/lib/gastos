export async function subirRecibo(grupo_id, gasto_id, archivo) {
  const path = `${grupo_id}/${gasto_id}-${Date.now()}.jpg`;
  const { error } = await supabase.storage.from("recibos").upload(path, archivo, { upsert: true });
  if (error) throw error;
  return path;
}

export async function urlRecibo(path) {
  const { data, error } = await supabase.storage.from("recibos").createSignedUrl(path, 3600);
  if (error) throw error;
  return data.signedUrl;
}

export async function saldarCuentas({ grupo_id, de_id, a_id, monto, moneda = "NZD", tc_a_base = 1 }) {
  const { data, error } = await supabase
    .from("pagos")
    .insert({ grupo_id, de_id, a_id, monto, moneda, tc_a_base })
    .select()
    .single();
  if (error) throw error;
  return data;
}

export async function sincronizarCola() {
  const cola = leerCola();
  if (!cola.length) return { enviados: 0, restantes: 0 };

  const quedan = [];
  let enviados = 0;

  for (const fila of cola) {
    try {
      const { pendiente, id, monto_base, deuda, creado, ...limpio } = fila;
      const { error } = await supabase.from("gastos").insert(limpio);
      if (error) throw error;
      enviados++;
    } catch {
      quedan.push(fila);
    }
  }
  guardarCola(quedan);
  return { enviados, restantes: quedan.length };
}

/* --------------------------------------------------------------- realtime */

export function escucharCambios(grupo_id, alCambiar) {
  const canal = supabase
    .channel(`grupo-${grupo_id}`)
    .on("postgres_changes",
      { event: "*", schema: "public", table: "gastos", filter: `grupo_id=eq.${grupo_id}` },
      alCambiar)
    .on("postgres_changes",
      { event: "*", schema: "public", table: "pagos", filter: `grupo_id=eq.${grupo_id}` },
      alCambiar)
    // Entrar o salir del grupo cambia entre cuántos se reparte, o sea todos
    // los saldos a la vez.
    .on("postgres_changes",
      { event: "*", schema: "public", table: "miembros", filter: `grupo_id=eq.${grupo_id}` },
      alCambiar)
    .subscribe();

  return () => supabase.removeChannel(canal);
}

/* ----------------------------------------------------------------- rubros */

/* Orden y valores validados con el script de accesibilidad del skill dataviz:
   pasan banda de luminosidad, chroma, separación para daltonismo y contraste
   (paleta cálida, contraste vs. superficie #F6F0E5 — el nuevo --papel).
   Si se reordenan o se cambia un color hay que volver a validarlos.
   Lista default: se usa como semilla en la migración 0007 y como respaldo
   si `rubros` todavía no cargó (o la migración no corrió) — la app nunca
   se queda sin categorías para mostrar. La lista real y editable por grupo
   vive en la tabla `rubros` (ver traerRubros más abajo). */
export const RUBROS = [
  { id: "casa", nombre: "Casa", color: "#B8541F" },
  { id: "comida", nombre: "Comida", color: "#02836F" },
  { id: "estudio", nombre: "Estudio", color: "#B98418" },
  { id: "tramites", nombre: "Trámites", color: "#7A5091" },
  { id: "salidas", nombre: "Salidas", color: "#7A9A2E" },
  { id: "transporte", nombre: "Transporte", color: "#AD4F5E" },
  { id: "setup", nombre: "Setup", color: "#3A6FD1" },
  { id: "otros", nombre: "Otros", color: "#A63D33" },
];

export const rubroDe = (id, rubros = RUBROS) =>
  rubros.find((r) => r.id === id) || rubros[rubros.length - 1] || RUBROS[RUBROS.length - 1];

export async function traerRubros(grupo_id) {
  const { data, error } = await supabase
    .from("rubros")
    .select("clave, nombre, color, orden")
    .eq("grupo_id", grupo_id)
    .order("orden", { ascending: true });
  if (error) throw error;
  return (data || []).map((r) => ({ id: r.clave, nombre: r.nombre, color: r.color }));
}

const claveDe = (nombre) =>
  sinAcentos(nombre).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || `rubro-${Date.now()}`;

export async function crearRubro(grupo_id, { nombre, color, orden = 0 }) {
  const clave = claveDe(nombre);
  const { error } = await supabase.from("rubros").insert({ grupo_id, clave, nombre, color, orden });
  if (error) throw error;
  return { id: clave, nombre, color };
}

export async function editarRubro(grupo_id, clave, cambios) {
  const { error } = await supabase.from("rubros").update(cambios)
    .eq("grupo_id", grupo_id).eq("clave", clave);
  if (error) throw error;
}

export async function borrarRubro(grupo_id, clave) {
  const { error } = await supabase.from("rubros").delete()
    .eq("grupo_id", grupo_id).eq("clave", clave);
  if (error) throw error;
}

/* ------------------------------------------------------- invitaciones */

/* Una invitación es permiso esperando, no un mail: acá no se manda nada. El
   invitado entra con su mail por el magic link y la app lo suma al grupo sola
   (ver traerContexto y la función aceptar_invitacion de la migración 0011). */

export const emailValido = (s) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s).trim());

export async function traerInvitaciones(grupo_id) {
  const { data, error } = await supabase
    .from("invitaciones")
    .select("id, email, alias, creada, aceptada_en")
    .eq("grupo_id", grupo_id)
    .is("aceptada_en", null)
    .order("creada", { ascending: true });
  if (error) throw error;
  return data;
}

export async function crearInvitacion(grupo_id, { email, alias }) {
  const { data, error } = await supabase
    .from("invitaciones")
    // El mail se guarda en minúscula: la unique y la búsqueda al aceptar
    // comparan así, y el que invita lo escribe a mano.
    .insert({ grupo_id, email: email.trim().toLowerCase(), alias: alias.trim() })
    .select()
    .single();
  if (error) throw error;
  return data;
}

export async function borrarInvitacion(id) {
  const { error } = await supabase.from("invitaciones").delete().eq("id", id);
  if (error) throw error;
}

/* ------------------------------------------------------------- monedas */

/* Tasas fijas de referencia, tomadas el 21-22/08/2026 (blue venta ~$1550
   ARS/USD). No se actualizan en vivo — son un punto de partida editable
   a mano en el formulario. Base = NZD. */
export const TASAS = { NZD: 1, USD: 1.6717, AUD: 1.1907, ARS: 0.0010785 };
export const tasaDe = (moneda) => TASAS[moneda] ?? 1;