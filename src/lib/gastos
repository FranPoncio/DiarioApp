import { supabase } from "./supabase";
import { sinAcentos } from "./formato";

/* La UI nunca espera a la red: el gasto se pinta primero, se manda después,
   y si no hay señal queda en cola hasta que vuelva. */

const COLA = "dbd:cola";

const leerCola = () => {
  try { return JSON.parse(localStorage.getItem(COLA) || "[]"); }
  catch { return []; }
};
const guardarCola = (c) => localStorage.setItem(COLA, JSON.stringify(c));

export const cantidadEnCola = () => leerCola().length;

/* -------------------------------------------------------------- lecturas */

export async function traerContexto() {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return null;

  const { data: miembros, error } = await supabase
    .from("miembros")
    .select("grupo_id, user_id, alias, color")
    // Orden estable: las columnas del Resumen son una por miembro, y si el
    // orden cambia entre consultas la tabla baila.
    .order("alias", { ascending: true });
  if (error) throw error;

  // Sin grupo puede ser que nunca lo invitaron, o que lo hayan invitado y esta
  // sea su primera entrada. Se prueba aceptar antes de dar por perdido: la
  // función es un no-op si no hay invitación pendiente para su mail.
  if (!miembros?.length) {
    const { data: grupoNuevo } = await supabase.rpc("aceptar_invitacion");
    if (!grupoNuevo) return { user, grupo_id: null, miembros: [], rubros: RUBROS };
    return traerContexto();
  }

  const grupo_id = miembros[0].grupo_id;
  let rubros;
  try { rubros = await traerRubros(grupo_id); }
  catch { rubros = []; }

  return {
    user,
    grupo_id,
    miembros: miembros.filter((m) => m.grupo_id === grupo_id),
    yo: miembros.find((m) => m.user_id === user.id),
    rubros: rubros.length ? rubros : RUBROS,
  };
}

const PAGINA = 1000;

/* `limite` corta la consulta: sirve para las vistas de lista, que solo
   muestran los últimos. Sin `limite` trae TODO lo del rango paginando —
   los totales del Resumen tienen que ser exactos, no los primeros N. */
export async function traerGastos(grupo_id, { desde, hasta, limite } = {}) {
  const arma = () => {
    let q = supabase
      .from("gastos")
      .select("*")
      .eq("grupo_id", grupo_id)
      .order("fecha", { ascending: false })
      .order("creado", { ascending: false });
    if (desde) q = q.gte("fecha", desde);
    if (hasta) q = q.lte("fecha", hasta);
    return q;
  };

  if (limite) {
    const { data, error } = await arma().limit(limite);
    if (error) throw error;
    return data;
  }

  const todo = [];
  for (let pagina = 0; ; pagina++) {
    const { data, error } = await arma().range(pagina * PAGINA, (pagina + 1) * PAGINA - 1);
    if (error) throw error;
    todo.push(...data);
    if (data.length < PAGINA) return todo;
  }
}

/* Quién le debe a quién. El neto por persona no alcanza con más de dos:
   te dice cuánto te deben en total, no de quién cobrarlo. */
export async function traerSaldosPorPar(grupo_id) {
  const { data, error } = await supabase
    .from("saldos_por_par")
    .select("acreedor_id, deudor_id, saldo")
    .eq("grupo_id", grupo_id);
  if (error) throw error;
  return data;
}

/* Las filas de saldos_por_par que te involucran, ya resueltas a alias y
   ordenadas por monto. `saldo` positivo es que esa persona te debe; negativo,
   que le debés. Se descartan los saldos que redondean a cero: un centavo de
   diferencia no es una deuda que valga mostrar. */
export function deudasDe(pares, yo_id, miembros) {
  if (!yo_id) return [];
  return (pares || [])
    .filter((p) => p.acreedor_id === yo_id)
    .map((p) => ({
      user_id: p.deudor_id,
      alias: miembros.find((m) => m.user_id === p.deudor_id)?.alias || "?",
      saldo: Number(p.saldo) || 0,
    }))
    .filter((d) => Math.abs(d.saldo) >= 0.01)
    .sort((a, b) => Math.abs(b.saldo) - Math.abs(a.saldo));
}

/* Resumen en una línea para Hoy y Resumen, donde no entra la lista completa.
   Con dos personas dice lo de siempre ("Le debés a Eve"); con más muestra el
   neto y el detalle queda en Gastos, que es donde se saldan las cuentas. */
export function textoSaldo(deudas, hayOtros) {
  if (!hayOtros) return { texto: "Todavía no hay nadie más en el grupo", tono: "cero", monto: null };
  if (!deudas.length) return { texto: "Están a mano", tono: "cero", monto: null };

  if (deudas.length === 1) {
    const [d] = deudas;
    return d.saldo > 0
      ? { texto: `${d.alias} te debe`, tono: "favor", monto: d.saldo }
      : { texto: `Le debés a ${d.alias}`, tono: "debo", monto: -d.saldo };
  }

  // Con varios, unos te pueden deber y vos deberle a otros: contar personas
  // "en una dirección" mentiría. Se muestra el neto y el detalle va en Gastos.
  const neto = deudas.reduce((acc, d) => acc + d.saldo, 0);
  if (Math.abs(neto) < 0.01) return { texto: "Están a mano", tono: "cero", monto: null };
  return neto > 0
    ? { texto: "Te deben en total", tono: "favor", monto: neto }
    : { texto: "Debés en total", tono: "debo", monto: -neto };
}

